enum NotificationType {
  PROJECT_DELETED
  INVITED
}

model ProjectNotification {
  id          String           @id @default(cuid())
  userId      String
  projectId   String
  projectName String
  type        NotificationType @default(PROJECT_DELETED)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}